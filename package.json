{
  "name": "catalog-update-action",
  "version": "1.0.0",
  "description": "Automated dependency updates for catalog: protocol monorepos (Bun, pnpm, Yarn)",
  "license": "MIT",
  "author": "brandhaug",
  "homepage": "https://github.com/brandhaug/catalog-update-action#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandhaug/catalog-update-action.git"
  },
  "bugs": {
    "url": "https://github.com/brandhaug/catalog-update-action/issues"
  },
  "keywords": [
    "bun",
    "pnpm",
    "yarn",
    "catalog",
    "dependabot",
    "dependency-updates",
    "github-action",
    "monorepo",
    "workspaces"
  ],
  "type": "module",
  "bin": {
    "catalog-update": "src/main.ts"
  },
  "files": [
    "src",
    "schema.json"
  ],
  "scripts": {
    "start": "bun src/main.ts",
    "dry-run": "bun src/main.ts --dry-run",
    "test": "bun test",
    "lint": "bunx oxlint --type-aware src/ test/",
    "fmt": "bunx oxfmt src/",
    "fmt:check": "bunx oxfmt --check src/",
    "dead-code": "fallow dead-code --fail-on-regression",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-effect": "0.12.0",
    "oxlint-tsgolint": "catalog:",
    "ultracite": "7.10.6"
  },
  "catalog": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "@types/bun": "1.4.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [],
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "yaml": "2.9.0"
  }
}
